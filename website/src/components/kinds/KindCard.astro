---
import { kindById } from "./kinds";

interface Props {
  kind: string;
  // Each neighbor: [kind id, test, label?]. The id doubles as the link target.
  choose?: [string, string, string?][];
}

const { kind: id, choose = [] } = Astro.props;
const kind = kindById(id);
const typeLabel = kind.type === "signal" ? "Signal" : "Decision";
---

<article class:list={["kind-card", "not-content", `kind-card--${kind.type}`]} id={kind.id}>
  <header class="kind-card__head">
    <h3 class="kind-card__name">{kind.name}</h3>
    <span class="kind-card__type">{typeLabel}</span>
    <p class="kind-card__question">{kind.question}</p>
  </header>

  <div class="kind-card__row">
    <div class="kind-card__label" aria-hidden="true"></div>
    <div class="kind-card__body"><slot /></div>
  </div>

  <div class="kind-card__row">
    <div class="kind-card__label">Choose it over</div>
    <div class="kind-card__body">
      {
        choose.length > 0 ? (
          <dl class="kind-card__choose">
            {choose.map(([neighbor, test, label]) => (
              <>
                <dt>
                  <a href={`#${neighbor}`}>{label ?? kindById(neighbor).name}</a>
                </dt>
                <dd>{test}</dd>
              </>
            ))}
          </dl>
        ) : (
          <slot name="choose" />
        )
      }
    </div>
  </div>

  <div class="kind-card__row">
    <div class="kind-card__label">How it ends</div>
    <div class="kind-card__body"><slot name="ends" /></div>
  </div>

  <div class="kind-card__row">
    <div class="kind-card__label">Example</div>
    <div class="kind-card__body kind-card__example"><slot name="example" /></div>
  </div>
</article>

<style>
  .kind-card {
    --kind-color: var(--sl-color-blue-high);
    --card-bg: color-mix(in srgb, var(--sl-color-bg), white 70%);
    --card-border: color-mix(in srgb, var(--sl-color-gray-5) 80%, transparent);
    --card-rule: color-mix(in srgb, var(--sl-color-gray-5) 55%, transparent);
    --card-shadow: 0 1px 2px rgb(30 25 15 / 0.05), 0 6px 16px -4px rgb(30 25 15 / 0.08),
      0 22px 44px -18px rgb(30 25 15 / 0.16);
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 1rem;
    box-shadow: var(--card-shadow);
    margin-block: 2.5rem;
    scroll-margin-top: calc(var(--sl-nav-height, 3.5rem) + 1.5rem);
  }
  :global(:root[data-theme="dark"]) .kind-card {
    --card-bg: color-mix(in srgb, var(--sl-color-bg), white 5%);
    --card-border: color-mix(in srgb, var(--sl-color-gray-4) 45%, transparent);
    --card-rule: color-mix(in srgb, var(--sl-color-gray-4) 30%, transparent);
    --card-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04), 0 2px 4px rgb(0 0 0 / 0.25),
      0 22px 44px -18px rgb(0 0 0 / 0.6);
  }
  .kind-card--decision {
    --kind-color: var(--sl-color-purple-high);
  }

  .kind-card__head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.35rem 1rem;
    padding: 1.6rem 2rem 1.4rem;
  }
  .kind-card__name {
    margin: 0;
    font-size: var(--sl-text-2xl);
    font-weight: 600;
    line-height: 1.2;
    color: var(--sl-color-white);
  }
  .kind-card__type {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--kind-color);
    text-align: right;
  }
  .kind-card__question {
    grid-column: 1 / -1;
    margin: 0;
    font-size: var(--sl-text-xl);
    font-weight: 300;
    line-height: 1.3;
    color: var(--sl-color-gray-2);
  }

  .kind-card__row {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1.75rem;
    padding: 1.1rem 2rem;
    border-top: 1px solid var(--card-rule);
  }
  .kind-card__row:last-child {
    padding-bottom: 1.4rem;
  }
  .kind-card__label {
    padding-top: 0.15rem;
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    color: var(--sl-color-gray-3);
    text-align: right;
  }
  .kind-card__body {
    color: var(--sl-color-gray-1);
    line-height: 1.65;
  }
  .kind-card__body :global(p) {
    margin: 0;
  }
  .kind-card__body :global(p + p),
  .kind-card__body :global(p + ul),
  .kind-card__body :global(ul + p) {
    margin-top: 0.75rem;
  }
  .kind-card__body :global(ul) {
    margin: 0;
    padding-left: 1.1rem;
  }
  .kind-card__body :global(li + li) {
    margin-top: 0.35rem;
  }
  .kind-card__body :global(code) {
    font-size: 0.9em;
    padding: 0.1em 0.3em;
    border-radius: 0.25rem;
    background: var(--sl-color-gray-6);
  }
  .kind-card__body :global(strong) {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .kind-card__choose {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.5rem 1.25rem;
    margin: 0;
  }
  .kind-card__choose dt {
    font-weight: 600;
  }
  .kind-card__choose dt a {
    color: var(--sl-color-white);
    text-decoration: none;
    border-bottom: 1px solid var(--sl-color-gray-4);
  }
  .kind-card__choose dt a:hover,
  .kind-card__choose dt a:focus-visible {
    border-bottom-color: var(--kind-color);
  }
  .kind-card__choose dd {
    margin: 0;
  }

  .kind-card__example {
    color: var(--sl-color-gray-2);
    font-style: italic;
  }

  @media (max-width: 40rem) {
    .kind-card {
      border-radius: 0.85rem;
    }
    .kind-card__head,
    .kind-card__row {
      padding-inline: 1.15rem;
    }
    .kind-card__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
    .kind-card__label {
      text-align: left;
      padding-top: 0;
    }
    .kind-card__label:empty {
      display: none;
    }
    .kind-card__choose {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }
    .kind-card__choose dd + dt {
      margin-top: 0.5rem;
    }
  }
</style>
