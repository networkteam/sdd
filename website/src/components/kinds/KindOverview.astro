---
import { kinds, type EntryType } from "./kinds";

const groups: { type: EntryType; label: string }[] = [
  { type: "signal", label: "Signals record something noticed" },
  { type: "decision", label: "Decisions record something committed to" },
];
---

<div class="kind-overview not-content">
  {
    groups.map(({ type, label }) => (
      <section class:list={["kind-overview__group", `kind-overview__group--${type}`]}>
        <p class="kind-overview__label">{label}</p>
        <ul class="kind-overview__tiles">
          {kinds
            .filter((k) => k.type === type)
            .map((k) => (
              <li>
                <a class="kind-overview__tile" href={`#${k.id}`}>
                  <span class="kind-overview__name">{k.name}</span>
                  <span class="kind-overview__question">{k.question}</span>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .kind-overview {
    display: grid;
    gap: 1.75rem;
    margin-block: 2rem 2.5rem;
  }
  .kind-overview__group {
    --kind-color: var(--sl-color-blue-high);
  }
  .kind-overview__group--decision {
    --kind-color: var(--sl-color-purple-high);
  }
  .kind-overview__label {
    margin: 0 0 0.75rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--kind-color);
  }
  .kind-overview__tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .kind-overview__tile {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    height: 100%;
    padding: 0.85rem 1rem;
    background: color-mix(in srgb, var(--sl-color-bg), white 70%);
    border: 1px solid color-mix(in srgb, var(--sl-color-gray-5) 80%, transparent);
    border-radius: 0.75rem;
    box-shadow: 0 1px 2px rgb(30 25 15 / 0.05), 0 6px 14px -8px rgb(30 25 15 / 0.12);
    text-decoration: none;
    transition: border-color 120ms ease, box-shadow 120ms ease;
  }
  :global(:root[data-theme="dark"]) .kind-overview__tile {
    background: color-mix(in srgb, var(--sl-color-bg), white 5%);
    border-color: color-mix(in srgb, var(--sl-color-gray-4) 45%, transparent);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04), 0 8px 18px -10px rgb(0 0 0 / 0.6);
  }
  .kind-overview__tile:hover,
  .kind-overview__tile:focus-visible {
    border-color: var(--kind-color);
  }
  .kind-overview__name {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .kind-overview__question {
    font-size: var(--sl-text-sm);
    line-height: 1.4;
    color: var(--sl-color-gray-2);
  }
  @media (prefers-reduced-motion: reduce) {
    .kind-overview__tile {
      transition: none;
    }
  }
</style>
