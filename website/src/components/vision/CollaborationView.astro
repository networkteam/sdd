---
import DiagramFrame from "./DiagramFrame.astro";
---

<DiagramFrame
  label="The collaboration view"
  caption="Every double-headed line is dialogue: nothing moves into the shared picture without a turn of conversation. Line style follows the same marks as everywhere else: firm where it works today, evenly dashed where the shape is decided, finely dashed where it is still an idea."
>
    <svg class="vision-diagram" viewBox="0 0 920 620" role="img" aria-labelledby="collabTitle collabDesc">
      <title id="collabTitle">The collaboration view</title>
      <desc id="collabDesc">Three people, each at a different surface and each paired with an agent, all in dialogue with a shared graph in the middle. An arc across the top shows person-to-person dialogue. Below the graph, three background agents work over it: intake, sync and review.</desc>

      <path d="M139 104 C 260 46, 660 46, 781 104" fill="none" stroke="#0f766e" stroke-width="1.4" marker-start="url(#ar-teal-r)" marker-end="url(#ar-teal)"></path>
      <rect x="314" y="44" width="292" height="34" rx="8" fill="#ffffff"></rect>
      <text class="s-b" x="460" y="58" text-anchor="middle">person to person: SDD prepares the meeting,</text>
      <text class="s-b" x="460" y="70" text-anchor="middle">then sorts the notes into the record afterwards</text>

      <g>
        <circle cx="150" cy="112" r="11" fill="#ffffff" stroke="#3e4c59" stroke-width="1.6"></circle>
        <path d="M131 140 a19 19 0 0 1 38 0" fill="none" stroke="#3e4c59" stroke-width="1.6"></path>
        <text class="s-h2" x="150" y="162" text-anchor="middle">Project lead</text>
        <rect x="52" y="174" width="196" height="26" rx="8" fill="#f0f8f7" stroke="#0f766e" stroke-width="1.3"></rect>
        <use href="#mk-works" x="64" y="181" width="12" height="12"></use>
        <text class="s-m" x="82" y="191">terminal with a coding agent</text>
        <line x1="150" y1="200" x2="150" y2="216" stroke="#0f766e" stroke-width="1.3" marker-start="url(#ar-teal-r)" marker-end="url(#ar-teal)"></line>
        <rect x="72" y="216" width="156" height="42" rx="10" fill="#ffffff" stroke="#0f766e" stroke-width="1.4"></rect>
        <text class="s-h2" x="150" y="234" text-anchor="middle">agent</text>
        <text class="s-m" x="150" y="248" text-anchor="middle">thinking partner</text>
        <path d="M150 258 C 150 290, 300 290, 352 314" fill="none" stroke="#0f766e" stroke-width="1.3" marker-start="url(#ar-teal-r)" marker-end="url(#ar-teal)"></path>
      </g>

      <g>
        <circle cx="460" cy="112" r="11" fill="#ffffff" stroke="#3e4c59" stroke-width="1.6"></circle>
        <path d="M441 140 a19 19 0 0 1 38 0" fill="none" stroke="#3e4c59" stroke-width="1.6"></path>
        <text class="s-h2" x="460" y="162" text-anchor="middle">Product owner</text>
        <rect x="362" y="174" width="196" height="26" rx="8" fill="#ffffff" stroke="#0f766e" stroke-width="1.3" stroke-dasharray="5 4"></rect>
        <use href="#mk-decided" x="374" y="181" width="12" height="12"></use>
        <text class="s-m" x="392" y="191">hosted, in the browser</text>
        <line x1="460" y1="200" x2="460" y2="216" stroke="#0f766e" stroke-width="1.3" stroke-dasharray="4 3" marker-start="url(#ar-teal-r)" marker-end="url(#ar-teal)"></line>
        <rect x="382" y="216" width="156" height="42" rx="10" fill="#ffffff" stroke="#0f766e" stroke-width="1.4"></rect>
        <text class="s-h2" x="460" y="234" text-anchor="middle">agent</text>
        <text class="s-m" x="460" y="248" text-anchor="middle">thinking partner</text>
        <line x1="460" y1="258" x2="460" y2="300" stroke="#0f766e" stroke-width="1.3" stroke-dasharray="4 3" marker-start="url(#ar-teal-r)" marker-end="url(#ar-teal)"></line>
      </g>

      <g>
        <circle cx="770" cy="112" r="11" fill="#ffffff" stroke="#3e4c59" stroke-width="1.6"></circle>
        <path d="M751 140 a19 19 0 0 1 38 0" fill="none" stroke="#3e4c59" stroke-width="1.6"></path>
        <text class="s-h2" x="770" y="162" text-anchor="middle">Designer</text>
        <rect x="672" y="174" width="196" height="26" rx="8" fill="#ffffff" stroke="#94a3b8" stroke-width="1.3" stroke-dasharray="2.6 2.4"></rect>
        <use href="#mk-idea" x="684" y="181" width="12" height="12"></use>
        <text class="s-m" x="702" y="191">chat, voice, seeing it laid out</text>
        <line x1="770" y1="200" x2="770" y2="216" stroke="#94a3b8" stroke-width="1.3" stroke-dasharray="2.6 2.4" marker-start="url(#ar-grey-r)" marker-end="url(#ar-grey)"></line>
        <rect x="692" y="216" width="156" height="42" rx="10" fill="#ffffff" stroke="#0f766e" stroke-width="1.4"></rect>
        <text class="s-h2" x="770" y="234" text-anchor="middle">agent</text>
        <text class="s-m" x="770" y="248" text-anchor="middle">thinking partner</text>
        <path d="M770 258 C 770 290, 620 290, 568 314" fill="none" stroke="#94a3b8" stroke-width="1.3" stroke-dasharray="2.6 2.4" marker-start="url(#ar-grey-r)" marker-end="url(#ar-grey)"></path>
      </g>

      <g>
        <rect x="350" y="300" width="220" height="106" rx="16" fill="#f0f8f7" stroke="#0f766e" stroke-width="2.2"></rect>
        <use href="#mk-works" x="453" y="312" width="13" height="13"></use>
        <text class="s-core-l" x="460" y="346" text-anchor="middle">The graph</text>
        <text class="s-core-s" x="460" y="364" text-anchor="middle">one shared picture</text>
        <text class="s-core-s" x="460" y="379" text-anchor="middle">of the project</text>
        <g stroke="#0f766e" stroke-width="1" fill="#0f766e">
          <line x1="410" y1="392" x2="440" y2="392"></line>
          <line x1="440" y1="392" x2="466" y2="386"></line>
          <line x1="466" y1="386" x2="492" y2="393"></line>
          <line x1="492" y1="393" x2="512" y2="387"></line>
          <circle cx="410" cy="392" r="2.6"></circle>
          <circle cx="440" cy="392" r="2.6"></circle>
          <circle cx="466" cy="386" r="2.6"></circle>
          <circle cx="492" cy="393" r="2.6"></circle>
          <circle cx="512" cy="387" r="2.6"></circle>
        </g>
      </g>

      <g>
        <path d="M372 406 C 320 430, 240 432, 190 458" fill="none" stroke="#94a3b8" stroke-width="1.2" stroke-dasharray="2.6 2.4" marker-start="url(#ar-grey-r)" marker-end="url(#ar-grey)"></path>
        <line x1="460" y1="406" x2="460" y2="458" stroke="#0f766e" stroke-width="1.2" stroke-dasharray="4 3" marker-start="url(#ar-teal-r)" marker-end="url(#ar-teal)"></line>
        <path d="M548 406 C 600 430, 680 432, 730 458" fill="none" stroke="#94a3b8" stroke-width="1.2" stroke-dasharray="2.6 2.4" marker-start="url(#ar-grey-r)" marker-end="url(#ar-grey)"></path>

        <rect x="58" y="458" width="200" height="56" rx="10" fill="#ffffff" stroke="#94a3b8" stroke-width="1.4" stroke-dasharray="2.6 2.4"></rect>
        <use href="#mk-idea" x="72" y="472" width="12" height="12"></use>
        <text class="s-h2" x="92" y="482">intake</text>
        <text class="s-m" x="72" y="500">brings the outside world in</text>

        <rect x="360" y="458" width="200" height="56" rx="10" fill="#ffffff" stroke="#0f766e" stroke-width="1.4" stroke-dasharray="5 4"></rect>
        <use href="#mk-decided" x="374" y="472" width="12" height="12"></use>
        <text class="s-h2" x="394" y="482">sync</text>
        <text class="s-m" x="374" y="500">keeps everyone’s copy in step</text>

        <rect x="662" y="458" width="200" height="56" rx="10" fill="#ffffff" stroke="#94a3b8" stroke-width="1.4" stroke-dasharray="2.6 2.4"></rect>
        <use href="#mk-idea" x="676" y="472" width="12" height="12"></use>
        <text class="s-h2" x="696" y="482">review</text>
        <text class="s-m" x="676" y="500">notices when two calls clash</text>

        <text class="s-eyebrow" x="460" y="546" text-anchor="middle">AGENTS WORKING IN THE BACKGROUND</text>
        <text class="s-b" x="460" y="566" text-anchor="middle">Nobody is asking them anything; they work over the shared picture on their own.</text>
        <text class="s-b" x="460" y="582" text-anchor="middle">They contribute according to rules and guidelines that live in the graph itself.</text>
      </g>
    </svg>
</DiagramFrame>

<style>
  svg text { font-family: inherit; }
  .s-eyebrow { font-size: 10.5px; letter-spacing: 0.11em; font-weight: 650; fill: #7b8794; }
  .s-h2 { font-size: 12px; font-weight: 650; fill: #1f2933; }
  .s-b { font-size: 10.5px; fill: #3e4c59; }
  .s-m { font-size: 9.5px; fill: #52606d; }
  .s-core-l { font-size: 15px; font-weight: 650; fill: #115e59; }
  .s-core-s { font-size: 10.5px; fill: #3e4c59; }
</style>
